{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!specs", "!README.md", "!CLAUDE.md", "!bun.lock"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			// Promise solta é bug em fluxo financeiro (erro engolido, ordem quebrada). Grupo nursery no Biome 2.6.3.
			"nursery": {
				"noFloatingPromises": "error"
			},
			"style": {
				// Desligada de propósito: com emitDecoratorMetadata, `import type` apaga o token de DI do Nest
				// e a injeção por tipo de construtor falha em runtime (ADR-0020, spike T-004).
				"useImportType": "off"
			}
		}
	},
	"javascript": {
		// Nest controllers use parameter decorators (@Body, @Param); without this Biome fails to parse them
		// (aprovado pelo autor na W5). Nenhuma regra de lint foi desligada.
		"parser": { "unsafeParameterDecoratorsEnabled": true },
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
