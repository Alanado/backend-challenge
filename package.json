{
	"name": "distributed-wagering-processor",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test:unit": "bun test test/unit",
		"test:integration": "bun test test/integration",
		"test:concurrency": "bun test --pass-with-no-tests test/concurrency",
		"test": "bun run test:unit && bun run test:integration && bun run test:concurrency",
		"spike:nest-mikro": "bun run spikes/nest-mikro/main.ts",
		"migration:up": "bun run scripts/migrate.ts up",
		"migration:down": "bun run scripts/migrate.ts down",
		"migration:create": "bun run scripts/migrate.ts create",
		"spike:sqs": "bun run spikes/sqs/main.ts",
		"commitlint": "commitlint",
		"hooks:install": "git config core.hooksPath .githooks",
		"prepare": "bun run hooks:install",
		"spike:tooling": "bun run spikes/tooling/main.ts",
		"queues:create": "bun run scripts/create-queues.ts",
		"test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait && SQS_ENDPOINT=http://localhost:4567 bun run scripts/create-queues.ts",
		"test:infra:down": "docker compose -f docker-compose.test.yml down -v",
		"compose:smoke": "bun run scripts/compose-smoke.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/big.js": "7.0.0",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@types/bun": "1.4.4",
		"@types/express": "5.0.6",
		"@types/pg": "8.23.1",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@aws-sdk/client-sqs": "3.1158.0",
		"@mikro-orm/core": "7.2.5",
		"@mikro-orm/migrations": "7.2.5",
		"@mikro-orm/nestjs": "7.1.0",
		"@mikro-orm/postgresql": "7.2.5",
		"@nestjs/common": "12.3.2",
		"@nestjs/core": "12.3.2",
		"@nestjs/platform-express": "12.3.2",
		"big.js": "7.0.1",
		"nestjs-pino": "5.3.1",
		"pg": "8.23.1",
		"pino": "10.4.0",
		"pino-http": "11.0.0",
		"prom-client": "15.1.3",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"zod": "4.6.7"
	}
}
