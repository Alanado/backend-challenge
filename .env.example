# Variáveis de ambiente (valores fictícios). Padrões e validação: src/shared/config.ts (02-design §8).

# Infra de desenvolvimento (docker-compose.yml)
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
SQS_ENDPOINT=http://localhost:4566
# NODE_ENV=development  PORT=3000  LOG_LEVEL=info
# SQS_REGION=us-east-1  SQS_ACCESS_KEY_ID=test  SQS_SECRET_ACCESS_KEY=test
# SQS_QUEUE_NAME=wager-transactions.fifo  SQS_DLQ_NAME=wager-transactions-dlq.fifo
# SQS_EVENTS_QUEUE_NAME=wager-events.fifo  (SQS_QUEUE_URL / SQS_EVENTS_QUEUE_URL opcionais)
# SHUTDOWN_GRACE_MS=20000 (espera dos handlers no SIGTERM)  SHUTDOWN_DRAIN_DELAY_MS=0 (pausa com readiness 503 antes de fechar o HTTP)
# TEST_FAULT= (somente testes; recusada com NODE_ENV=production)

# Infra de teste (docker-compose.test.yml); usadas por test/support/infra.ts
TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering_test
TEST_SQS_ENDPOINT=http://localhost:4567

# Opcionais dos spikes (spikes/*): padrão = infra de teste
# SPIKE_DATABASE_URL=postgres://wagering:wagering@localhost:5433/spike
# SPIKE_SQS_ENDPOINT=http://localhost:4567
